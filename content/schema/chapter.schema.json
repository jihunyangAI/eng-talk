{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chapter.schema.json",
  "title": "Chapter",
  "type": "object",
  "required": ["id", "order", "title", "description", "level", "category", "cover", "dialogue"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "order": { "type": "integer", "minimum": 1 },
    "title": { "$ref": "#/$defs/localized" },
    "description": { "$ref": "#/$defs/localized" },
    "level": { "enum": ["beginner", "intermediate", "advanced"] },
    "category": { "enum": ["hotel-work", "cruise-work", "travel", "stay", "food", "shopping", "daily", "people"] },
    "cover": { "$ref": "#/$defs/imagePath" },
    "dialogue": {
      "type": "object",
      "required": ["speakers", "lines", "scenes"],
      "additionalProperties": false,
      "properties": {
        "speakers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "name", "role", "look"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "role": { "$ref": "#/$defs/localized" },
              "look": { "type": "string", "minLength": 1 },
              "voice": {
                "type": "object",
                "required": ["name", "voiceId"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "voiceId": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "lines": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "speaker", "en", "ko", "th"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "speaker": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 },
              "ko": { "type": "string", "minLength": 1 },
              "th": { "type": "string", "minLength": 1 },
              "audio": { "type": "string", "pattern": "^/audio/.+\\.mp3$" }
            }
          }
        },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "lines", "image", "prompt"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "lines": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string" } },
              "image": { "$ref": "#/$defs/imagePath" },
              "prompt": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "required": ["en", "ko", "th"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "ko": { "type": "string", "minLength": 1 },
        "th": { "type": "string", "minLength": 1 }
      }
    },
    "imagePath": { "type": "string", "pattern": "^/images/.+\\.(webp|png|jpg|jpeg)$" }
  }
}
